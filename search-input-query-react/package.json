{
  "name": "search-input-query-react",
  "version": "0.7.8",
  "keywords": [
    "search",
    "parser",
    "query",
    "typescript"
  ],
  "author": "William Cotton",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamcotton/search-input-query"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/SearchInputQuery.d.ts",
      "import": "./dist/esm/SearchInputQuery.js",
      "require": "./dist/cjs/SearchInputQuery.js"
    }
  },
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit",
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "search-input-query-parser": "^0.7.8"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "search-input-query-parser": "^0.7.8",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "npm-check-updates": "^19.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1"
  },
  "license": "MIT"
}
