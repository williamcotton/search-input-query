{
  "name": "search-input-query-react",
  "version": "0.8.0",
  "keywords": [
    "search",
    "parser",
    "query",
    "typescript"
  ],
  "author": "William Cotton",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamcotton/search-input-query"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/SearchInputQuery.d.ts",
      "import": "./dist/esm/SearchInputQuery.js",
      "require": "./dist/cjs/SearchInputQuery.js"
    }
  },
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit",
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "search-input-query-parser": "^0.7.8"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "search-input-query-parser": "^0.8.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "npm-check-updates": "^22.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
